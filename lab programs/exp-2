      "source": [
        "import csv\n",
        "\n",
        "# Create a CSV dataset\n",
        "data = [\n",
        "    ['Sky', 'Temperature', 'Humidity', 'Wind', 'Water', 'Forecast', 'EnjoySport'],\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High', 'Weak', 'Warm', 'Change', 'No'],\n",
        "    ['Sunny', 'Warm', 'High', 'Weak', 'Warm', 'Same', 'Yes']\n",
        "]\n",
        "\n",
        "with open('training_data.csv', 'w', newline='') as f:\n",
        "    writer = csv.writer(f)\n",
        "    writer.writerows(data)\n",
        "\n",
        "# Read the CSV dataset\n",
        "with open('training_data.csv', 'r') as f:\n",
        "    reader = csv.reader(f)\n",
        "    dataset = list(reader)\n",
        "\n",
        "attributes = dataset[0][:-1]\n",
        "examples = dataset[1:]\n",
        "\n",
        "# Extract attribute values\n",
        "domains = [\n",
        "    list(set(row[i] for row in examples))\n",
        "    for i in range(len(attributes))\n",
        "]\n",
        "\n",
        "# Initial boundaries\n",
        "S = [['Ø'] * len(attributes)]\n",
        "G = [['?'] * len(attributes)]\n",
        "\n",
        "def covers(h, x):\n",
        "    return all(h[i] == '?' or h[i] == x[i]\n",
        "               for i in range(len(h)))\n",
        "\n",
        "def generalize(h, x):\n",
        "    new_h = h.copy()\n",
        "    for i in range(len(h)):\n",
        "        if h[i] == 'Ø':\n",
        "            new_h[i] = x[i]\n",
        "        elif h[i] != x[i]:\n",
        "            new_h[i] = '?'\n",
        "    return new_h\n",
        "\n",
        "def specialize(h, x):\n",
        "    result = []\n",
        "    for i in range(len(h)):\n",
        "        if h[i] == '?':\n",
        "            for value in domains[i]:\n",
        "                if value != x[i]:\n",
        "                    new_h = h.copy()\n",
        "                    new_h[i] = value\n",
        "                    result.append(new_h)\n",
        "        elif h[i] != 'Ø' and h[i] == x[i]:\n",
        "            continue\n",
        "    return result\n",
        "\n",
        "# Candidate-Elimination Algorithm\n",
        "for row in examples:\n",
        "    x = row[:-1]\n",
        "    label = row[-1]\n",
        "\n",
        "    if label == 'Yes':\n",
        "        G = [g for g in G if covers(g, x)]\n",
        "\n",
        "        new_S = []\n",
        "        for s in S:\n",
        "            if covers(s, x):\n",
        "                new_S.append(s)\n",
        "            else:\n",
        "                new_S.append(generalize(s, x))\n",
        "\n",
        "        S = new_S\n",
        "\n",
        "        G = [g for g in G\n",
        "             if any(covers(g, x) for s in S)]\n",
        "\n",
        "    else:\n",
        "        S = [s for s in S if not covers(s, x)]\n",
        "\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            if not covers(g, x):\n",
        "                new_G.append(g)\n",
        "            else:\n",
        "                for h in specialize(g, x):\n",
        "                    if any(covers(h, e[:-1])\n",
        "                           for e in examples if e[-1] == 'Yes'):\n",
        "                        new_G.append(h)\n",
        "\n",
        "        G = new_G\n",
        "\n",
        "# Display results\n",
        "print(\"Specific Boundary (S):\")\n",
        "for h in S:\n",
        "    print(h)\n",
        "\n",
        "print(\"\\nGeneral Boundary (G):\")\n",
        "for h in G:\n",
        "    print(h)"
